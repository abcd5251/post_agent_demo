# ─── 自動發文 pipeline（main.py）───────────────────────────
# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Sheet：網址 https://docs.google.com/spreadsheets/d/<這一段就是 ID>/edit
GOOGLE_SHEET_ID=
# Service Account 金鑰。本機可以填 JSON 檔路徑（例如 google-service-account.json）；
# Render 上請把整個 JSON 內容貼進來（一行或多行都可以）
GOOGLE_SERVICE_ACCOUNT_JSON=google-service-account.json

# Buffer：https://publish.buffer.com/settings/api
BUFFER_API_KEY=
# 選填：Buffer 裡同一平台有多個頻道時才需要，用 python main.py check 查 id
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=

# Cloudinary（放圖片：Buffer / IG 只收公開圖片網址）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── legacy/ 舊腳本才需要 ───────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=v20.0
META_PAGE_ACCESS_TOKEN=
CLOUDINARY_UPLOAD_FOLDER=auto_posting
